# Node 24+ loads this file with: node --env-file=.env server.js
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=.data/billing.sqlite
BUSINESS_NAME="The Office of Yash SR: Payment Portal"
# Production requires HTTPS and an exact public origin:
# NODE_ENV=production
# PUBLIC_ORIGIN=https://o.yashsr.com
# Optional separate customer and administrator domains (set both in production):
# CUSTOMER_ORIGIN=https://secure.yashsr.com
# ADMIN_ORIGIN=https://secure-admin.yashsr.com

# Docker Compose domain (use this hostname in Cloudflare DNS):
# DOMAIN=payments.yashsr.com

# Optional email: add these through your host's secret/environment settings.
# Verify your sending domain with Resend before enabling. Never commit a real key.
# RESEND_API_KEY=
# MAIL_FROM=payments@yashsr.com
# ADMIN_EMAIL=your-admin-email@example.com
